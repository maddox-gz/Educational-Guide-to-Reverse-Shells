```ini
[Unit]
Description=Reverse SSH Tunnel
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=targetuser
Group=targetgroup
EnvironmentFile=/etc/reverse-ssh/target.env
ExecStart=/opt/reverse-ssh/target-scripts/reverse-ssh.sh -c /etc/reverse-ssh/target.env
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reverse-ssh

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target