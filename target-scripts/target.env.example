```bash
#===============================================================================
# Reverse SSH Tunnel Configuration
# Copy this file to target.env and edit values accordingly
#===============================================================================

# Attacker server details
ATTACKER_USER="revuser"
ATTACKER_HOST="attacker.example.com"
ATTACKER_PORT=22

# Path to SSH private key on target
SSH_KEY="/path/to/target_key"

# Reverse forward settings
# Port on attacker machine that will be forwarded
REMOTE_FORWARD_PORT=2222

# Target host/port to forward to (usually localhost:22 for SSH)
TARGET_SSH_HOST="localhost"
TARGET_SSH_PORT=22

# Keep‑alive settings
SERVER_ALIVE_INTERVAL=60
SERVER_ALIVE_COUNT_MAX=3

# Logging
LOG_LEVEL="INFO"          # DEBUG, INFO, WARN, ERROR
LOG_FILE="/var/log/reverse-ssh.log"

# Use autossh if available (for reverse-ssh.sh)
USE_AUTOSSH=true

# Additional SSH options (optional)
# SSH_OPTIONS="-o StrictHostKeyChecking=accept-new"